# Конфигурация для docker-compose.yml
# Скопируйте в .env и заполните

# ── Панель ─────────────────────────────────────────────────────────────
APP_URL=https://panel.example.com
APP_NAME=GameDock
APP_TIMEZONE=Europe/Moscow
APP_LOCALE=ru

# ── База данных ────────────────────────────────────────────────────────
DB_DATABASE=gamedock
DB_USERNAME=gamedock
DB_PASSWORD=        # сгенерируйте: openssl rand -base64 24
DB_ROOT_PASSWORD=   # сгенерируйте отдельно

# ── Redis ──────────────────────────────────────────────────────────────
REDIS_PASSWORD=     # сгенерируйте: openssl rand -hex 32

# ── Локальная нода ─────────────────────────────────────────────────────
# Токен берётся в панели: Админка → Ноды → создать → скопировать токен
GD_AGENT_TOKEN=
GD_NODE_ID=1

# Режимы (см. config/hosting.php)
GD_NODE_MODE=auto
GD_RUNTIME=docker

# Порт WSS-сервера панели
WSS_PORT=9222

# ── Бот ────────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
GD_BOT_PANEL_TOKEN=      # API-токен из панели: Профиль → API-токены

# ── Почта ──────────────────────────────────────────────────────────────
MAIL_MAILER=log

# ── Файлы ──────────────────────────────────────────────────────────────
FILESYSTEM_DISK=local
# Для S3 (бэкапы, аватары, вложения):
# FILESYSTEM_DISK=s3
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=ru-central1
# AWS_BUCKET=
# AWS_ENDPOINT=

# ── Платежи ────────────────────────────────────────────────────────────
GD_YOOKASSA_SHOP_ID=
GD_YOOKASSA_SECRET_KEY=
GD_TINKOFF_TERMINAL_KEY=
GD_TINKOFF_PASSWORD=
GD_CRYPTOBOT_TOKEN=

# ── Защита ─────────────────────────────────────────────────────────────
GD_TURNSTILE_SITE_KEY=
GD_TURNSTILE_SECRET_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
VK_CLIENT_ID=
VK_CLIENT_SECRET=
