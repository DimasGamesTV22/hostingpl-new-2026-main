# Тестовое окружение GameDock.
# Копируется автоматически, если .env.testing отсутствует.

APP_NAME=GameDock
APP_ENV=testing
APP_KEY=base64:Qm9vdENoZWNrMTIzNDU2Nzg5MGFiY2RlZmdoaWprbG1ub3BxcnN0dXZ3eHl6
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost

APP_LOCALE=ru
APP_FALLBACK_LOCALE=en

# Тесты гоняются на SQLite в памяти — внешняя БД не нужна.
DB_CONNECTION=sqlite
DB_DATABASE=:memory:

SESSION_DRIVER=array
CACHE_STORE=array
QUEUE_CONNECTION=sync
MAIL_MAILER=array

# Провайдеры, которые в тестах не должны ходить наружу.
HOSTING_AGENT_TOKEN=
TELEGRAM_BOT_TOKEN=
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
TINKOFF_TERMINAL_KEY=
TINKOFF_PASSWORD=
CRYPTOBOT_TOKEN=
