APP_NAME=GameDock
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Europe/Moscow
APP_LOCALE=ru
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=debug

# ── База данных ────────────────────────────────────────────────────────────
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=gamedock
DB_USERNAME=gamedock
DB_PASSWORD=
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

# ── Redis ──────────────────────────────────────────────────────────────────
REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=
REDIS_PORT=6379

# ── Очереди / кэш / сессии ────────────────────────────────────────────────
QUEUE_CONNECTION=redis
CACHE_STORE=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=10080
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# ── Почта ──────────────────────────────────────────────────────────────────
MAIL_MAILER=smtp
MAIL_HOST=smtp.yandex.ru
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@example.com
MAIL_FROM_NAME="${APP_NAME}"

# ── Панель: выбор режима (см. config/hosting.php) ──────────────────────────
# node_mode: single | manual | auto
GD_NODE_MODE=auto
# runtime: docker | podman | lxc | native
GD_RUNTIME=docker
GD_DOCKER_SOCKET=/var/run/docker.sock
GD_SERVERS_ROOT=/home/gamedock/servers
GD_BACKUPS_ROOT=/home/gamedock/backups
GD_SYSTEM_USER=gamedock
GD_SYSTEM_GROUP=gamedock

# ── Агент (входящий режим: агенты подключаются к панели) ──────────────────
GD_AGENT_INBOUND=true
GD_AGENT_URL=
GD_AGENT_SHARED_SECRET=change-me-agent-shared-secret

# ── Telegram ───────────────────────────────────────────────────────────────
GD_TELEGRAM_BOT_TOKEN=
GD_TELEGRAM_BOT_USERNAME=
GD_TELEGRAM_ADMIN_CHAT_ID=

# ── Платежи ────────────────────────────────────────────────────────────────
GD_PAYMENTS_ENABLED=true
GD_YOOKASSA_SHOP_ID=
GD_YOOKASSA_SECRET_KEY=
GD_TINKOFF_TERMINAL_KEY=
GD_TINKOFF_PASSWORD=
GD_CRYPTOBOT_TOKEN=
GD_PAYMENT_SUCCESS_URL=http://localhost:8000/payment/success
GD_PAYMENT_CANCEL_URL=http://localhost:8000/payment/cancel

# ── S3-совместимое хранилище (аватары, вложения, бэкапы) ───────────────────
GD_S3_ENABLED=false
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ru-central1
AWS_BUCKET=
AWS_ENDPOINT=
AWS_URL=
AWS_PREFIX=gamedock
GD_BACKUP_BUCKET=

# ── Защита ─────────────────────────────────────────────────────────────────
GD_TURNSTILE_SITE_KEY=
GD_TURNSTILE_SECRET_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
VK_CLIENT_ID=
VK_CLIENT_SECRET=

# ── Брендинг ───────────────────────────────────────────────────────────────
GD_BRAND_NAME=GameDock
GD_BRAND_LEGAL=GameDock LLC
GD_SUPPORT_EMAIL=support@example.com
GD_DOCS_URL=
GD_UPDATE_URL=

# ── Очереди (приоритеты) ────────────────────────────────────────────────────
GD_QUEUE_PROVISIONING=provisioning
GD_QUEUE_BILLING=billing
GD_QUEUE_BACKUPS=backups
GD_QUEUE_MONITORING=monitoring
