# ── Telegram ─────────────────────────────────────────────────────────────
# Токен от @BotFather
TELEGRAM_BOT_TOKEN=123456789:AAExampleTokenReplaceMe

# longPolling (проще для старта) | webhook (для продакшена за nginx)
TELEGRAM_MODE=longPolling

# Публичный HTTPS-адрес панели для webhook-режима
#TELEGRAM_WEBHOOK_URL=https://panel.example.com

# Chat-id админов через запятую: получают алерты и подтверждения оплат.
# Узнать свой id: напишите боту /start, затем откройте
# https://api.telegram.org/bot<TOKEN>/getUpdates и посмотрите chat.id
GD_ADMIN_CHATS=

# ── Панель ───────────────────────────────────────────────────────────────
GD_PANEL_URL=https://panel.example.com

# API-токен панели: Профиль → API-токены, право servers:control.
# Без него бот не сможет управлять серверами.
GD_PANEL_TOKEN=
GD_PANEL_TIMEOUT=15000

# ── Приём оплаты (@CryptoBot) ────────────────────────────────────────────
# Основной приём делает панель (POST /webhooks/cryptobot).
# Здесь — резервный канал для сверки инвойсов.
GD_CRYPTOBOT_TOKEN=
GD_CRYPTOBOT_MODE=webhook

# ── Прочее ───────────────────────────────────────────────────────────────
GD_TZ=Europe/Moscow
PORT=8090
LOG_LEVEL=info
#LOG_FILE=/var/log/gamedock-bot.log
